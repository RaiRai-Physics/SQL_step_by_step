Harder: Window functions

1. Rank customers by spending
SELECT
    c.customer_id,
    c.customer_name,
    SUM(o.total_amount) AS total_spent,
    RANK() OVER (
        ORDER BY SUM(o.total_amount) DESC
    ) AS spending_rank
FROM customers c
JOIN orders o
    ON c.customer_id = o.customer_id
WHERE o.status = 'Completed'
GROUP BY 
    c.customer_id,
    c.customer_name
ORDER BY spending_rank;

2. Find each customer’s first completed order
WITH ranked_orders AS (
    SELECT
        o.*,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id
            ORDER BY order_date
        ) AS rn
    FROM orders o
    WHERE status = 'Completed'
)
SELECT
    customer_id,
    order_id,
    order_date,
    total_amount
FROM ranked_orders
WHERE rn = 1;

3. Find each customer’s latest completed order
WITH ranked_orders AS (
    SELECT
        o.*,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id
            ORDER BY order_date DESC
        ) AS rn
    FROM orders o
    WHERE status = 'Completed'
)
SELECT
    customer_id,
    order_id,
    order_date,
    total_amount
FROM ranked_orders
WHERE rn = 1;
